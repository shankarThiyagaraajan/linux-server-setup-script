# Alert settings: copy to /etc/server-setup/alerts.env with mode 600, or set
# them up in the dashboard (Alerts, key 6). Parsed, never executed.
# Only https:// addresses are accepted. Leave out what you don't use.

ALERT_NTFY_URL="https://ntfy.sh/replace-with-a-long-random-topic"
#ALERT_NTFY_TOKEN=""
#ALERT_WEBHOOK_URL="https://example.com/hooks/server-setup"
#ALERT_SLACK_WEBHOOK="https://hooks.slack.com/services/..."
#ALERT_TELEGRAM_TOKEN="123456:ABC..."
#ALERT_TELEGRAM_CHAT="123456789"
#ALERT_EMAIL_TO="ops@example.com"    # needs msmtp set up in /etc/msmtprc

# important (important and critical) | critical
ALERT_MIN_LEVEL="important"
# Full disks, low memory, failed services
ALERT_HEALTH="true"
