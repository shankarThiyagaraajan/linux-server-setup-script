# server-setup settings for an unattended run:
#   sudo server-setup setup --yes --type server --config config.env
#
# The file is read as KEY="value" lines; it is never executed. Unknown keys
# are an error, and every value is checked before anything changes.
# The wizard writes the same format to /etc/server-setup/config.env.

# What to set up: base | web (adds ports 80/443) | custom
PROFILE="base"
COMPONENTS="ssh firewall fail2ban autoupdates timesync watch schedule"

# Admin accounts (sudo + SSH). The first one is the primary admin.
ADMIN_USERS="ops"
# Public key for the primary admin: the key text or a path to a .pub file.
# Keys for other admins go in /etc/server-setup/keys/<name>.pub
ADMIN_PUBKEY="/root/ops.pub"
# Password for sudo, as a hash (never plain text): openssl passwd -6
# Kept out of the saved config. Leave blank if the account already has one.
ADMIN_PASSWORD_HASH=''
# Only for automation accounts. Admins without a password then use sudo freely.
ALLOW_NOPASSWD_SUDO="false"

# Existing accounts that keep SSH access (they are added to ssh-users).
SSH_USERS=""
# Blank keeps the current port. A new port is opened alongside the old one;
# log in on the new port and run `sudo server-setup confirm` within 10 minutes,
# or the SSH change is undone automatically.
SSH_PORT=""
# no | local | yes
SSH_FORWARDING="local"

# Extra ports to open, e.g. "80/tcp 443/tcp 6000:6007/udp"
OPEN_PORTS=""
# Your office or VPN ranges: never rate-limited or banned
TRUSTED_CIDRS=""

# Automatic security updates; reboot only if you allow it (never on a personal computer)
AUTO_REBOOT="false"
REBOOT_TIME="04:00"
# Blank keeps the current time zone, e.g. "Europe/London"
TIMEZONE=""

# Scheduled maintenance (component "schedule"): which jobs run, and what the
# weekly job installs: security | all | none
MAINT_DAILY="true"
MAINT_WEEKLY="true"
MAINT_MONTHLY="true"
MAINT_UPDATES="security"
MAINT_BACKUPS_KEEP="8"

# Optional hardening to apply (see: sudo server-setup recommendations).
# Nothing optional is applied unless it is listed here.
RECOMMENDATIONS=""
