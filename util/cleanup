def protected_refs() -> tuple[set[str], set[str]]:
    """sha256 hex strings and image refs that TBO releases pin (current, previous, history)."""
    hexes: set[str] = set()
    refs: set[str] = set()
    files: list[Path] = []
    for sub in ("releases",):
        d = HOME / "tbo" / sub
        if d.is_dir():
            files += [p for p in d.rglob("*") if p.is_file()]
    for f in set(files):
        try:
            if f.is_file() and f.stat().st_size < 5_000_000:
                text = f.read_text(errors="replace")
                hexes.update(re.findall(r"[0-9a-f]{64}", text))
                refs.update(re.findall(r"[\w./-]+(?::[\w.-]+)?@sha256:[0-9a-f]{64}|[\w.-]+(?:/[\w.-]+)+:[\w.-]+", text))
        except OSError:
            pass
    return hexes, refs


def scan_docker() -> list[Finding]:
    out: list[Finding] = []
    if not shutil.which("docker"):
        return out
    note("storage: docker...")
    r = run(["docker", "image", "ls", "-a", "--no-trunc", "--format", "{{json .}}"], 60)
    if not r or r.returncode != 0:
        return [Finding("info", "docker-unavailable", "docker", "docker not reachable (daemon down or no permission)", "skip", module="storage")]
    hexes, refs = protected_refs()
    used: set[str] = set()
    cr = run(["docker", "ps", "-aq"], 30)
    ids = (cr.stdout.split() if cr else [])
    if ids:
        ir = run(["docker", "inspect", "--format", "{{.Image}}", *ids], 60)
        used = {x.replace("sha256:", "") for x in (ir.stdout.split() if ir else [])}
    insp = run(["docker", "image", "inspect", "--format",
                "{{.Id}}\t{{.Size}}\t{{.Created}}\t{{join .RepoTags \",\"}}\t{{join .RepoDigests \",\"}}",
                *[json.loads(x)["ID"] for x in r.stdout.splitlines() if x.strip()]], 120)
    reclaim = 0
    for line in (insp.stdout if insp else "").splitlines():
        iid, size, created, tags, digests = (line.split("\t") + [""] * 5)[:5]
        hexid = iid.replace("sha256:", "")
        dig_hex = set(re.findall(r"[0-9a-f]{64}", digests))
        tag_list = [t for t in tags.split(",") if t]
        if hexid in used or hexid in hexes or dig_hex & hexes or dig_hex & used:
            continue
        if any(t in refs for t in tag_list) or any(d in refs for d in digests.split(",")):
            continue
        try:
            age = (time.time() - time.mktime(time.strptime(created[:19], "%Y-%m-%dT%H:%M:%S"))) / 86400
        except ValueError:
            age = 0
        if age < 7:
            continue
        sz = int(size or 0)
        reclaim += sz
        label = ", ".join(tag_list) or ("<untagged> " + (digests.split(",")[0] if digests else hexid[:12]))
        out.append(Finding("low", "docker-image", f"docker image {hexid[:12]}",
            f"{human(sz)} (shared layers may free less): {label}, {age:.0f} days old, no container, not pinned by ~/tbo releases",
            "save it to the archive (docker save), then remove the image; undo with `cleanup --recover` (docker load)",
            {"op": "docker-rmi", "id": iid, "label": label, "tags": tag_list, "bytes": sz}, module="storage", size=sz, recover="quarantine"))
    out.sort(key=lambda f: -f.size)
    r = run(["docker", "system", "df", "--format", "{{.Type}}\t{{.Reclaimable}}"], 60)
    for ln in (r.stdout if r else "").splitlines():
        t, rec = (ln.split("\t") + [""])[:2]
        if t == "Build Cache" and rec and not rec.startswith("0B"):
            out.append(Finding("low", "docker-build-cache", "docker build cache", f"{rec} reclaimable (unused for over a week)",
                "docker builder prune --filter until=168h",
                {"op": "cmd", "argv": ["docker", "builder", "prune", "-f", "--filter", "until=168h"], "sudo": False},
                module="storage", recover="regenerates"))
    out.append(Finding("info", "docker-policy", "docker", "images pinned by ~/tbo/releases (current and previous), images used by any container, and all volumes are never offered",
        "volumes hold data: review them by hand with `docker volume ls`", module="storage"))
    return out


# ------------------------------------------------------------------ RAM

PROTECTED_PROC = re.compile(
    r"^(systemd|init|Xorg|Xwayland|gnome-.*|gdm.*|dbus.*|pipewire.*|pulseaudio|wireplumber|sshd|tmux.*|screen|dockerd|containerd.*|docker.*|"
    r"postgres.*|redis.*|temporal.*|keycloak.*|caddy|java|NetworkManager|snapd|cron|bash|zsh|fish|sh|login|sudo|"
    r"tbo.*|claude|codex|node|python.*|ibus.*|polkit.*|udisks.*|cleanup)$")


def meminfo() -> dict[str, int]:
    out = {}
    for ln in Path("/proc/meminfo").read_text().splitlines():
        k, v = ln.split(":", 1)
        out[k] = int(v.split()[0]) * 1024
    return out


def ancestors() -> set[int]:
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        try:
            pid = int(re.search(r"PPid:\s+(\d+)", Path(f"/proc/{pid}/status").read_text()).group(1))
        except (OSError, AttributeError):
            break
    return pids


def scan_ram() -> list[Finding]:
    out: list[Finding] = []
    mi = meminfo()
    total, avail = mi["MemTotal"], mi["MemAvailable"]
    cache = mi.get("Cached", 0) + mi.get("Buffers", 0)
    swap_used = mi.get("SwapTotal", 0) - mi.get("SwapFree", 0)
    pct_avail = avail / total * 100
    sev = "high" if pct_avail < 8 else "medium" if pct_avail < 15 or (mi.get("SwapTotal") and swap_used / mi["SwapTotal"] > 0.7) else "low"
    out.append(Finding(sev, "ram-status", "memory", f"{human(total - avail)} in use of {human(total)}; {human(avail)} available ({pct_avail:.0f}%); "
        f"swap {human(swap_used)} of {human(mi.get('SwapTotal', 0))} used; page cache {human(cache)}",
        "free memory by closing the biggest apps below, or drop the page cache", module="ram"))
    if cache > 4 * 1024**3:
        out.append(Finding("low", "drop-cache", "page cache", f"{human(cache)} of file cache (the kernel gives it back by itself when apps need RAM)",
            "sudo sync; drop_caches. Safe but the gain is short-lived",
            {"op": "cmd", "argv": ["sh", "-c", "sync; echo 3 > /proc/sys/vm/drop_caches"], "sudo": True},
            module="ram", size=cache, recover="regenerates", risk="sudo"))
    if mi.get("SwapTotal") and swap_used > 2 * 1024**3:
        if avail > swap_used * 1.3:
            out.append(Finding("low", "swap-reclaim", "swap", f"{human(swap_used)} sits in swap and {human(avail)} RAM is free: can pull it back",
                "sudo swapoff -a && sudo swapon -a (slow, 1 to several minutes, system may stutter)",
                {"op": "cmd", "argv": ["sh", "-c", "swapoff -a && swapon -a"], "sudo": True}, module="ram", recover="regenerates", risk="sudo"))
        else:
            out.append(Finding("info", "swap-heavy", "swap", f"{human(swap_used)} in swap but only {human(avail)} RAM available, so it cannot be pulled back safely",
                "close apps first, then scan again", module="ram"))
    # process groups
    mine = ancestors()
    groups: dict[str, dict] = {}
    r = run(["ps", "-u", str(os.getuid()), "-o", "pid=,rss=,stat=,comm="], 15)
    zombies = 0
    for ln in (r.stdout if r else "").splitlines():
        parts = ln.split(None, 3)
        if len(parts) < 4:
            continue
        pid, rss, stat, comm = int(parts[0]), int(parts[1]) * 1024, parts[2], parts[3].strip()
        if stat.startswith("Z"):
            zombies += 1
            continue
        g = groups.setdefault(comm, {"rss": 0, "pids": []})
        g["rss"] += rss
        g["pids"].append(pid)
    if zombies:
        out.append(Finding("info", "zombies", "processes", f"{zombies} zombie process(es) (take no RAM)", "their parent must reap them; restart the parent if the count grows", module="ram"))
    for comm, g in sorted(groups.items(), key=lambda kv: -kv[1]["rss"])[:8]:
        if g["rss"] < 300 * 1024**2:
            continue
        prot = bool(PROTECTED_PROC.match(comm)) or bool(set(g["pids"]) & mine)
        msg = f"{human(g['rss'])} across {len(g['pids'])} process(es)"
        if prot:
            out.append(Finding("info", "ram-hog", f"{comm}", msg + " (protected: system, service or this session; not offered)", "close it yourself if you want", module="ram", size=g["rss"]))
        else:
            out.append(Finding("low", "ram-hog", f"{comm}", msg, f"ask it to quit (SIGTERM); its command lines are saved so `cleanup --recover` can relaunch it",
                {"op": "terminate", "comm": comm, "pids": g["pids"]}, module="ram", size=g["rss"], recover="relaunch", risk="terminate"))
    return out


# ------------------------------------------------------- archive and fix

RECOVER_TEXT = {
    "quarantine": "undo: cleanup --recover",
    "regenerates": "comes back by itself",
    "relaunch": "relaunch from --recover",
    "reinstall": "reinstallable",
    "irreversible": "CANNOT be undone",
    "": "",
}
SHORT_RECOVER = {"quarantine": "↩ undoable", "regenerates": "♻ regrows", "relaunch": "↩ relaunch", "reinstall": "↩ reinstall", "irreversible": "⚠ FINAL"}
DEFAULT_RECOVER = {"trash": "quarantine", "drop-index-line": "quarantine", "copy": "quarantine",
                   "add-index-line": "quarantine", "rebuild-index": "quarantine", "rmdir": "quarantine"}


def recover_kind(f: Finding) -> str:
    return f.recover or DEFAULT_RECOVER.get(f.fix.get("op", ""), "")


class Batch:
    def __init__(self, stamp: str):
        self.stamp = stamp
        self.dir = TRASH / stamp
        self.entries: list[dict] = []

    def store_path(self, original: Path, suffix: str = "") -> Path:
        dest = self.dir / (str(original).lstrip("/") + suffix)
        dest.parent.mkdir(parents=True, exist_ok=True)
        return dest

    def save(self) -> None:
        if self.entries:
            self.dir.mkdir(parents=True, exist_ok=True)
            mf = self.dir / "manifest.json"
            old = json.loads(mf.read_text()) if mf.exists() else []
            mf.write_text(json.dumps(old + self.entries, indent=1))


def trash(path: Path, batch: Batch, module: str) -> Path:
    size = du(path) if path.is_dir() else path.stat().st_size
    dest = batch.store_path(path)
    shutil.move(str(path), dest)
    batch.entries.append({"type": "file", "module": module, "original": str(path), "stored": str(dest), "bytes": size})
    return dest


def backup(path: Path, batch: Batch) -> Path:
    dest = batch.store_path(path, ".bak")
    shutil.copy2(path, dest)
    batch.entries.append({"type": "file", "module": "claude", "original": str(path), "stored": str(dest), "overwrite": True, "bytes": path.stat().st_size})
    return dest


def apply_fix(f: Finding, batch: Batch, permanent: bool = False, dry: bool = False) -> str:
    fx = f.fix
    op = fx["op"]
    if dry:
        return f"[dry run] would {op}: {json.dumps({k: v for k, v in fx.items() if k != 'op'})}"
    if op == "trash":
        if permanent:
            p = Path(fx["path"])
            shutil.rmtree(p) if p.is_dir() and not p.is_symlink() else p.unlink()
            return f"deleted permanently, freed {human(f.size)}"
        dest = trash(Path(fx["path"]), batch, f.module)
        return f"archived to {short(dest)}"
    if op == "rm":
        p = Path(fx["path"])
        if fx.get("keep_dir"):
            for c in p.iterdir():
                shutil.rmtree(c) if c.is_dir() and not c.is_symlink() else c.unlink()
        else:
            shutil.rmtree(p)
        return "deleted"
    if op == "rmdir":
        trash(Path(fx["path"]), batch, f.module)
        return "archived"
    if op == "drop-index-line":
        p = Path(fx["index"])
        backup(p, batch)
        lines = p.read_text().splitlines(keepends=True)
        del lines[fx["line"] - 1]
        p.write_text("".join(lines))
        return "line removed (old version archived)"
    if op == "add-index-line":
        p = Path(fx["index"])
        backup(p, batch)
        text = p.read_text()
        p.write_text(text + ("" if text.endswith("\n") or not text else "\n") + f"- [{fx['title']}]({fx['file']}) — {fx['hook'] or '(add a one-line hook)'}\n")
        return "index line added"
    if op == "rebuild-index":
        d = Path(fx["dir"])
        lines = []
        for md in sorted(d.glob("*.md")):
            if md.name != INDEX:
                m = parse_memory(md)
                lines.append(f"- [{m.name or md.stem}]({md.name}) — {m.description or '(add a hook)'}\n")
        (d / INDEX).write_text("".join(lines))
        batch.entries.append({"type": "created", "module": "claude", "original": str(d / INDEX)})
        return f"{INDEX} written with {len(lines)} lines (undo removes it)"
    if op == "copy":
        dst = Path(fx["dst"])
        backup(dst, batch)
        shutil.copy2(fx["src"], dst)
        return "copied (old version archived)"
    if op == "cmd":
        if fx.get("sudo") and not sys.stdin.isatty():
            return "skipped: needs sudo and a terminal"
        r = subprocess.run((["sudo"] if fx.get("sudo") else []) + fx["argv"], capture_output=True, text=True)
        batch.entries.append({"type": "command", "module": f.module, "argv": fx["argv"], "sudo": bool(fx.get("sudo")), "returncode": r.returncode,
                              "recover": recover_kind(f)})
        tail = (r.stdout.strip().splitlines() or r.stderr.strip().splitlines() or [""])[-1]
        return ("done" if r.returncode == 0 else f"failed (exit {r.returncode})") + (f": {tail}" if tail else ".")
    if op == "docker-rmi":
        tar = batch.store_path(Path("/docker") / (fx["id"].replace("sha256:", "")[:12] + ".tar"))
        s = subprocess.run(["docker", "save", "-o", str(tar), *(fx.get("tags") or [fx["id"]])], capture_output=True, text=True)
        if s.returncode != 0:
            tar.unlink(missing_ok=True)
            return f"NOT removed: docker save failed ({s.stderr.strip()[:120]})"
        rm = subprocess.run(["docker", "rmi", fx["id"]], capture_output=True, text=True)
        batch.entries.append({"type": "docker-image", "module": "storage", "id": fx["id"], "label": fx["label"], "tags": fx.get("tags", []), "stored": str(tar), "bytes": tar.stat().st_size})
        if rm.returncode != 0:
            return f"saved to {short(tar)} but docker rmi failed: {rm.stderr.strip()[:120]} (nothing lost; the image is still there)"
        return f"saved to {short(tar)} and removed (docker load restores it)"
    if op == "terminate":
        saved, gone = [], 0
        for pid in fx["pids"]:
            try:
                cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[:-1]
                cwd = os.readlink(f"/proc/{pid}/cwd")
                exe = os.readlink(f"/proc/{pid}/exe")
                saved.append({"pid": pid, "argv": [c.decode(errors="replace") for c in cmdline], "cwd": cwd, "exe": exe})
            except OSError:
                pass
        for pid in fx["pids"]:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        time.sleep(3)
        for pid in fx["pids"]:
            try:
                state = re.search(r"State:\s+(\S)", Path(f"/proc/{pid}/status").read_text()).group(1)
            except (OSError, AttributeError):
                state = "Z"
            if state == "Z":
                gone += 1
        # relaunch only the main (first) process of the group; children come back with it
        main = saved[0] if saved else None
        batch.entries.append({"type": "process", "module": "ram", "comm": fx["comm"], "relaunch": main, "count": len(fx["pids"])})
        left = len(fx["pids"]) - gone
        return f"asked {len(fx['pids'])} process(es) to quit; {gone} gone" + (f", {left} still running (not force-killed)" if left else "")
    return "unknown op"


# ------------------------------------------------------------------- recover


def list_batches() -> list[Path]:
    return sorted((p for p in TRASH.glob("*") if p.is_dir() and (p / "manifest.json").exists()), reverse=True) if TRASH.exists() else []


def load_manifest(b: Path) -> list[dict]:
    try:
        return json.loads((b / "manifest.json").read_text())
    except (OSError, ValueError):
        return []


def batch_summary(b: Path) -> str:
    es = load_manifest(b)
    kinds: dict[str, int] = {}
    for e in es:
        kinds[e["type"]] = kinds.get(e["type"], 0) + 1
    size = sum(e.get("bytes", 0) for e in es)
    return f"{b.name}  {len(es)} entries ({', '.join(f'{n} {k}' for k, n in kinds.items())}), {human(size)} held"


def entry_line(e: dict) -> str:
    t = e["type"]
    if t == "file":
        return f"{'overwrite' if e.get('overwrite') else 'file'} {short(Path(e['original']))}"
    if t == "created":
        return f"created {short(Path(e['original']))} (undo deletes it)"
    if t == "docker-image":
        return f"docker image {e['label']} ({human(e.get('bytes', 0))})"
    if t == "process":
        r = e.get("relaunch")
        return f"process {e['comm']} x{e['count']}" + (f"  relaunch: {' '.join(r['argv'])[:90]}" if r and r['argv'] else "")
    if t == "command":
        return f"ran {'sudo ' if e.get('sudo') else ''}{' '.join(e['argv'])[:80]} ({RECOVER_TEXT.get(e.get('recover', ''), '')})"
    return t


def recover(batch_arg: str | None, assume_yes: bool) -> int:
    batches = list_batches()
    if not batches:
        print(f"Nothing to recover: {short(TRASH)} holds no archived batches.")
        return 0
    if batch_arg:
        chosen = [b for b in batches if b.name.startswith(batch_arg)]
        if not chosen:
            print(f"No batch matching '{batch_arg}'. Batches: {', '.join(b.name for b in batches)}")
            return 1
    elif assume_yes:
        chosen = batches[:1]
        print(f"-y given: recovering the newest batch ({chosen[0].name}).")
    elif not sys.stdin.isatty():
        for i, b in enumerate(batches, 1):
            print(f"{i}. {batch_summary(b)}")
        return 0
    else:
        print("Archived batches (newest first):")
        for i, b in enumerate(batches, 1):
            print(f"  {i}. {batch_summary(b)}")
        ans = input("Recover which? number, [a]ll, or Enter to cancel: ").strip().lower()
        if not ans:
            return 0
        chosen = batches if ans == "a" else [batches[int(ans) - 1]] if ans.isdigit() and 0 < int(ans) <= len(batches) else []
        if not chosen:
            print("Not a valid choice.")
            return 1
    restored = 0
    for b in chosen:
        remaining = []
        for e in load_manifest(b):
            line = entry_line(e)
            ok = None  # None = not recoverable, True/False = done/failed
            t = e["type"]
            if t == "command":
                print(f"info  {line}")
                continue
            if not assume_yes and sys.stdin.isatty():
                if key(f"restore {line} ? [Y/n] ", "y") == "n":
                    remaining.append(e)
                    continue
            try:
                if t == "file":
                    dest, src = Path(e["original"]), Path(e["stored"])
                    if dest.exists() and not e.get("overwrite"):
                        print(f"skip {short(dest)}: something exists there now")
                        remaining.append(e)
                        continue
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    if e.get("overwrite"):
                        shutil.copy2(src, dest)
                        src.unlink()
                    else:
                        shutil.move(str(src), dest)
                elif t == "created":
                    Path(e["original"]).unlink(missing_ok=True)
                elif t == "docker-image":
                    r = subprocess.run(["docker", "load", "-i", e["stored"]], capture_output=True, text=True)
                    if r.returncode != 0:
                        raise OSError(r.stderr.strip()[:150])
                    Path(e["stored"]).unlink(missing_ok=True)
                    if not e.get("tags"):
                        print("  note: image was untagged; it is back under its ID only (a registry digest reference is not restored)")
                elif t == "process":
                    rl = e.get("relaunch")
                    if not rl or not rl["argv"]:
                        print(f"cannot relaunch {e['comm']}: command line unknown")
                        continue
                    subprocess.Popen(rl["argv"], cwd=rl["cwd"] if Path(rl["cwd"]).is_dir() else None, executable=rl["exe"],
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                print(f"restored {line}")
                restored += 1
            except OSError as ex:
                print(f"failed {line}: {ex}")
                remaining.append(e)
        if remaining:
            (b / "manifest.json").write_text(json.dumps(remaining, indent=1))
        else:
            shutil.rmtree(b, ignore_errors=True)
    print(f"{restored} item(s) restored.")
    return 0


def purge(days: int | None, assume_yes: bool) -> int:
    batches = list_batches()
    cut = time.time() - (days or 0) * 86400
    old = [b for b in batches if days is None or b.stat().st_mtime < cut]
    if not old:
        print("Nothing to purge.")
        return 0
    total = 0
    for b in old:
        s = du(b)
        total += s
        print(f"  {batch_summary(b)}  (on disk: {human(s)})")
    print(f"Purging frees {human(total)} and makes these changes permanent (no more --recover).")
    if not assume_yes:
        if not sys.stdin.isatty() or input("Type 'yes' to purge: ").strip() != "yes":
            print("Cancelled.")
            return 0
    for b in old:
        shutil.rmtree(b, ignore_errors=True)
    print("Purged.")
    return 0


