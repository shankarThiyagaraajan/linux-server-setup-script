MODULES = ["storage", "ram", "claude"]
MODULE_TITLE = {"storage": "STORAGE", "ram": "RAM", "claude": "CLAUDE MEMORY"}

EPILOG = """\
Modules (-m, repeatable; default all):
  storage   caches, old build folders (target/, node_modules), /tmp, Docker images and build cache,
            apt cache, journal, snaps, desktop trash   (--deep adds a hunt for files over 1 GiB)
  ram       memory/swap pressure, page cache, biggest apps you can ask to quit
  claude    Claude Code memory folders: broken index, stale or duplicate notes (every ~/.claude* account)

Safety:
  Nothing is removed on a scan. Clean never deletes: it moves files, saves Docker images with
  `docker save`, and records the command line of quit apps, all under ~/.cleanup-trash/<timestamp>/.
  `--recover` puts them back (docker load, relaunch). Space is only freed by `--purge`.
  Items marked "CANNOT be undone" (journal, desktop trash) always need you to type yes.
  Never offered: Docker volumes, images pinned by ~/tbo releases or used by a container.

Examples:
  cleanup                         menu
  cleanup --scan                  report on everything
  cleanup --scan -m storage       storage only
  cleanup --clean -m ram          pick apps to quit
  cleanup --clean --dry-run       show what clean would do, change nothing
  cleanup --list-trash            show archived batches
  cleanup --recover               choose a batch to restore
  cleanup --recover 20261108      restore a batch by name (prefix ok)
  cleanup --purge 14              permanently free archived batches older than 14 days
  cleanup --scan -m claude --here only this folder's Claude project memory"""


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="cleanup", description="Scan, clean and recover disk space, RAM and Claude memory.",
                                 epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    g = ap.add_argument_group("action (default: menu on a terminal, else scan)")
    g.add_argument("--scan", action="store_true", help="report findings and recommendations; changes nothing")
    g.add_argument("--clean", "--fix", dest="clean", action="store_true", help="ask about each fixable finding and apply it with a recovery path")
    g.add_argument("--dry-run", action="store_true", help="with --clean: print what would happen, change nothing")
    g.add_argument("--recover", nargs="?", const="", metavar="BATCH", help="restore archived items; without BATCH, choose from a list")
    g.add_argument("--list-trash", action="store_true", help="list archived batches and their contents")
    g.add_argument("--purge", nargs="?", const=-1, type=int, metavar="DAYS", help="permanently free archived batches older than DAYS (no value: all)")
    f = ap.add_argument_group("scope and filters")
    f.add_argument("-m", "--module", action="append", choices=MODULES, help="module to run (repeatable); default: all")
    f.add_argument("--deep", action="store_true", help="storage: also search for files over 1 GiB (slower)")
    f.add_argument("--artifact-days", type=int, default=14, metavar="N", help="storage: target/ and node_modules unused for N days count as old (default 14)")
    f.add_argument("--here", action="store_true", help="claude: only the project for the current folder")
    f.add_argument("-p", "--project", metavar="TEXT", help="claude: only projects whose folder name contains TEXT")
    f.add_argument("--home", action="append", metavar="DIR", help="claude: config home to scan (repeatable); default: every ~/.claude*")
    f.add_argument("--stale-days", type=int, default=30, metavar="N", help="claude: project memory older than N days is stale (default 30)")
    f.add_argument("-c", "--category", action="append", choices=list(CATEGORIES), metavar="CAT",
                   help="show details (and clean only) this category; repeatable. Names: " + ", ".join(CATEGORIES))
    f.add_argument("--all", action="store_true", help="list every item in the details instead of the top 15 per category")
    f.add_argument("--min", default="low", choices=list(SEV_ORDER), help="hide findings below this severity (default low)")
    o = ap.add_argument_group("output")
    o.add_argument("--json", action="store_true", help="print findings as JSON")
    o.add_argument("-y", "--yes", action="store_true", help="skip per-item questions for recoverable, non-sudo items; never for irreversible, sudo or quit-app items")
    return ap


def collect(args) -> tuple[list[Finding], dict]:
    mods = args.module or MODULES
    findings: list[Finding] = []
    stats = {"folders": 0, "memories": 0}
    if "storage" in mods:
        findings += scan_storage(args.deep, args.artifact_days)
    if "ram" in mods:
        findings += scan_ram()
    if "claude" in mods:
        here = project_for_cwd(Path.cwd()) if args.here else None
        groups: dict[str, dict[str, dict[str, Memory]]] = {}
        for home in find_homes(args.home):
            for mdir in sorted((home / "projects").glob("*/memory")):
                proj = mdir.parent.name
                if (here and proj != here) or (args.project and args.project.lower() not in proj.lower()):
                    continue
                stats["folders"] += 1
                fs, mems = scan_memory_dir(mdir, args.stale_days)
                findings += fs
                groups.setdefault(proj, {})[home.name] = mems
        findings += scan_cross_home(groups)
        stats["memories"] = sum(len(m) for g in groups.values() for m in g.values())
    mark_sensitive(findings)
    findings = [f for f in findings if SEV_ORDER[f.severity] <= SEV_ORDER[args.min]]
    findings.sort(key=lambda f: (MODULES.index(f.module), SEV_ORDER[f.severity], -f.size, f.kind, f.where))
    return findings, stats


