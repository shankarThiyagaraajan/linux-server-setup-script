from dataclasses import asdict, dataclass, field
from pathlib import Path

HOME = Path.home()
TRASH = HOME / ".cleanup-trash"
INDEX = "MEMORY.md"
INDEX_MAX_LINES = 200  # Claude Code truncates MEMORY.md after about this many lines
VALID_TYPES = {"user", "feedback", "project", "reference"}
LINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
INDEX_LINE_RE = re.compile(r"^\s*-\s*\[([^\]]*)\]\(([^)]+)\)")
PATH_RE = re.compile(r"`((?:~|/home/)[^`\s]+)`")
STALE_WORDS = re.compile(r"\b(resume point|stopped|until|for now|temporar|tonight|tomorrow|this week|blocked on)\b", re.I)

SEV_ORDER = {"high": 0, "medium": 1, "low": 2, "info": 3}
COLORS = {"high": "\033[31m", "medium": "\033[33m", "low": "\033[36m", "info": "\033[2m"}
RESET = "\033[0m"


@dataclass
class Memory:
    path: Path
    name: str = ""
    description: str = ""
    type: str = ""
    body: str = ""
    has_frontmatter: bool = False
    mtime: float = 0.0


@dataclass
class Finding:
    severity: str
    kind: str
    where: str
    message: str
    action: str  # human recommendation
    fix: dict = field(default_factory=dict)  # machine action for --clean; empty = manual only
    module: str = "claude"  # storage | ram | claude
    size: int = 0  # bytes you could free (storage) or hold (ram)
    recover: str = ""  # quarantine | regenerates | relaunch | reinstall | irreversible
    risk: str = ""  # sudo | terminate: always asks, even with -y
    sensitive: bool = False  # folder holds secret-looking files


# ---------------------------------------------------------------- parsing


def parse_memory(path: Path) -> Memory:
    text = path.read_text(errors="replace")
    mem = Memory(path=path, mtime=path.stat().st_mtime)
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end != -1:
            mem.has_frontmatter = True
            for line in text[4:end].splitlines():
                m = re.match(r"^\s*(name|description|type)\s*:\s*(.*)$", line)
                if m:
                    val = m.group(2).strip().strip('"').strip("'")
                    if not getattr(mem, m.group(1)):
                        setattr(mem, m.group(1), val)
            text = text[end + 4 :]
    mem.body = text.strip()
    return mem


def parse_index(path: Path) -> list[tuple[int, str, str]]:
    """(line number, title, target file) for each index line."""
    if not path.exists():
        return []
    out = []
    for i, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
        m = INDEX_LINE_RE.match(line)
        if m:
            out.append((i, m.group(1), m.group(2).strip()))
    return out


# ------------------------------------------------------- project location


def resolve_project_path(encoded: str) -> Path | None:
    """Turn '-home-x-LAB-tbo-platform' back into a real folder, if one still exists.

    Claude Code encodes the cwd by replacing every non-alphanumeric character with '-',
    so we walk the filesystem and match child names under the same encoding.
    """
    target = encoded.lstrip("-")

    def enc(s: str) -> str:
        return re.sub(r"[^A-Za-z0-9]", "-", s)

    def walk(base: Path, rest: str) -> Path | None:
        if not rest:
            return base
        try:
            children = [c for c in base.iterdir() if c.is_dir()]
        except OSError:
            return None
        # longest names first, so 'tbo-platform' wins over 'tbo'
        for c in sorted(children, key=lambda c: -len(c.name)):
            e = enc(c.name)
            if rest == e:
                return c
            if rest.startswith(e + "-"):
                hit = walk(c, rest[len(e) + 1 :])
                if hit:
                    return hit
        return None

    return walk(Path("/"), target)


def session_cwd(project_dir: Path) -> str | None:
    for f in sorted(project_dir.glob("*.jsonl"), key=lambda p: -p.stat().st_mtime)[:3]:
        try:
            with f.open(errors="replace") as fh:
                for _, line in zip(range(50), fh):
                    m = re.search(r'"cwd"\s*:\s*"([^"]+)"', line)
                    if m:
                        return m.group(1)
        except OSError:
            pass
    return None


def project_for_cwd(cwd: Path) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", str(cwd))


# ---------------------------------------------------------------- checks


def similar(a: str, b: str) -> float:
    return difflib.SequenceMatcher(None, a.lower(), b.lower()).ratio()


def short(p: Path) -> str:
    s = str(p)
    return "~" + s[len(str(HOME)) :] if s.startswith(str(HOME)) else s


def scan_memory_dir(mdir: Path, stale_days: int) -> tuple[list[Finding], dict[str, Memory]]:
    findings: list[Finding] = []
    where = short(mdir)
    project_dir = mdir.parent
    files = sorted(p for p in mdir.iterdir() if p.is_file())
    mds = [p for p in files if p.suffix == ".md" and p.name != INDEX]
    others = [p for p in files if p.suffix != ".md"]

    # project folder gone?
    real = session_cwd(project_dir)
    real_path = Path(real) if real else resolve_project_path(project_dir.name)
    if real_path is None or not real_path.exists():
        guess = real or project_dir.name
        if mds:
            findings.append(Finding("high", "orphan-project", where,
                f"project folder no longer exists ({guess}); {len(mds)} memories nobody will load",
                "archive the memory folder (or move it to the project's new location)",
                {"op": "trash", "path": str(mdir)}))
        elif not files:
            findings.append(Finding("low", "orphan-project", where,
                f"project folder gone ({guess}) and memory folder empty",
                "remove the empty memory folder", {"op": "rmdir", "path": str(mdir)}))

    if not files:
        if not any(f.kind == "orphan-project" for f in findings):
            findings.append(Finding("info", "empty", where, "memory folder is empty",
                "nothing to do (Claude Code recreates it); remove if you want it tidy",
                {"op": "rmdir", "path": str(mdir)}))
        return findings, {}

    for p in others:
        findings.append(Finding("low", "stray-file", short(p), "non-markdown file in a memory folder",
            "move it out or archive it", {"op": "trash", "path": str(p)}))

    mems = {p.name: parse_memory(p) for p in mds}
    index_path = mdir / INDEX
    index = parse_index(index_path)
    indexed = {t for _, _, t in index}

    # index health
    if mds and not index_path.exists():
        findings.append(Finding("high", "no-index", where, f"{len(mds)} memories but no {INDEX}; none will load",
            f"rebuild {INDEX} from the files' descriptions", {"op": "rebuild-index", "dir": str(mdir)}))
    if index_path.exists():
        n_lines = len(index_path.read_text(errors="replace").splitlines())
        if n_lines > INDEX_MAX_LINES:
            findings.append(Finding("high", "index-too-long", short(index_path),
                f"{n_lines} lines (> {INDEX_MAX_LINES}); the tail is cut off when loaded",
                "merge or archive old memories to shorten the index"))
        seen: dict[str, int] = {}
        for ln, title, target in index:
            if target in seen:
                findings.append(Finding("medium", "index-duplicate", f"{short(index_path)}:{ln}",
                    f"'{target}' listed twice (also line {seen[target]})", "remove the duplicate line",
                    {"op": "drop-index-line", "index": str(index_path), "line": ln}))
            seen.setdefault(target, ln)
            if not (mdir / target).exists():
                findings.append(Finding("high", "index-dangling", f"{short(index_path)}:{ln}",
                    f"points to missing file '{target}' ({title})", "remove the index line",
                    {"op": "drop-index-line", "index": str(index_path), "line": ln}))
        for line in index_path.read_text(errors="replace").splitlines():
            if len(line) > 250:
                findings.append(Finding("low", "index-verbose", short(index_path),
                    f"index line of {len(line)} chars: '{line[:60]}...'",
                    "keep index lines to a short hook; detail belongs in the file"))

    for fname, m in mems.items():
        loc = short(m.path)
        if index_path.exists() and fname not in indexed:
            findings.append(Finding("high", "unindexed", loc, "not listed in MEMORY.md, so never loaded",
                "add an index line (or archive the file if it is no longer true)",
                {"op": "add-index-line", "index": str(index_path), "file": fname,
                 "title": m.name or fname[:-3], "hook": m.description}))
        missing = [k for k in ("name", "description", "type") if not getattr(m, k)]
        if not m.has_frontmatter:
            findings.append(Finding("medium", "no-frontmatter", loc, "no frontmatter block",
                "add name / description / metadata.type frontmatter"))
        elif missing:
            findings.append(Finding("medium", "frontmatter-missing", loc, f"frontmatter lacks {', '.join(missing)}",
                "fill in the missing fields"))
        if m.type and m.type not in VALID_TYPES:
            findings.append(Finding("low", "bad-type", loc, f"type '{m.type}' is not one of {sorted(VALID_TYPES)}",
                "fix the type"))
        if len(m.body) < 40:
            findings.append(Finding("medium", "thin", loc, f"body is only {len(m.body)} chars",
                "flesh it out or archive it", {"op": "trash", "path": str(m.path)}))
        if m.type in ("feedback", "project") and m.body and "**Why:**" not in m.body:
            findings.append(Finding("info", "no-why", loc, "feedback/project memory without a **Why:** line",
                "add the reason so it can be judged later"))
        age = (time.time() - m.mtime) / 86400
        if m.type == "project" and age > stale_days:
            findings.append(Finding("medium", "stale", loc, f"project memory untouched for {age:.0f} days",
                "check it is still true; update or archive", {"op": "trash", "path": str(m.path)}))
        elif m.type == "project" and STALE_WORDS.search(m.body or m.description):
            w = STALE_WORDS.search(m.body or m.description).group(0)
            findings.append(Finding("low", "time-bound", loc,
                f"reads as time-bound ('{w}'), {age:.0f} days old", "check whether it has expired",
                {"op": "trash", "path": str(m.path)}))
        for ref in PATH_RE.findall(m.body):
            p = Path(os.path.expanduser(ref.rstrip(".,;:)")))
            if not p.exists() and "<" not in ref and "*" not in ref:
                findings.append(Finding("low", "dead-path", loc, f"mentions a path that no longer exists: {ref}",
                    "update the path or archive the memory"))

    # duplicates within the folder
    names: dict[str, str] = {}
    for fname, m in mems.items():
        if m.name and m.name in names:
            findings.append(Finding("high", "duplicate-name", short(m.path),
                f"same name '{m.name}' as {names[m.name]}", "merge the two files"))
        names.setdefault(m.name, fname)
    items = list(mems.values())
    for i, a in enumerate(items):
        for b in items[i + 1 :]:
            d = similar(a.description, b.description) if a.description and b.description else 0
            body = similar(a.body[:1500], b.body[:1500])
            if d > 0.7 or body > 0.6:
                findings.append(Finding("medium", "near-duplicate", where,
                    f"{a.path.name} ~ {b.path.name} (description {d:.0%}, body {body:.0%})",
                    "merge into one file and drop the other"))

    # broken [[links]] are allowed by the convention; report as info
    all_names = {m.name for m in mems.values()}
    for m in mems.values():
        for link in set(LINK_RE.findall(m.body)):
            if link not in all_names:
                findings.append(Finding("info", "open-link", short(m.path),
                    f"[[{link}]] has no memory yet", "write it if it matters, else ignore"))
    return findings, mems


def scan_cross_home(groups: dict[str, dict[str, dict[str, Memory]]]) -> list[Finding]:
    """Same project in several ~/.claude* homes: flag copies and drift."""
    out = []
    for project, by_home in groups.items():
        homes = [h for h, mems in by_home.items() if mems]
        if len(homes) < 2:
            continue
        for i, ha in enumerate(homes):
            for hb in homes[i + 1 :]:
                for a in by_home[ha].values():
                    for b in by_home[hb].values():
                        s = similar(a.body[:1500], b.body[:1500])
                        same_name = a.name and a.name == b.name
                        if s > 0.95:
                            out.append(Finding("info", "cross-home-copy", project,
                                f"{ha}/{a.path.name} = {hb}/{b.path.name}", "fine if you want both accounts to know it"))
                        elif same_name or s > 0.6:
                            newer, older = (a, b) if a.mtime >= b.mtime else (b, a)
                            out.append(Finding("medium", "cross-home-drift", project,
                                f"{short(older.path)} differs from newer {short(newer.path)} ({s:.0%} alike)",
                                "copy the newer version over the older (or merge by hand)",
                                {"op": "copy", "src": str(newer.path), "dst": str(older.path)}))
    return out


def find_homes(explicit: list[str] | None) -> list[Path]:
    if explicit:
        return [Path(os.path.expanduser(h)) for h in explicit]
    return sorted(p for p in HOME.glob(".claude*") if (p / "projects").is_dir())


def key(prompt: str, default: str = "") -> str:
    """Read one key without Enter (falls back to a line when not on a terminal). Ctrl-C/Ctrl-D raise KeyboardInterrupt (handled in main)."""
    print(prompt, end="", flush=True)
    if not sys.stdin.isatty():
        return (sys.stdin.readline().strip().lower()[:1]) or default
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        ch = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    if ch in ("\x03", "\x04", ""):
        raise KeyboardInterrupt
    ch = default if ch in ("\r", "\n") else ch.lower()
    print(ch)
    return ch


# ------------------------------------------------------------ shared helpers


def human(n: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return str(n)


def run(argv: list[str], timeout: int = 60, sudo: bool = False) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run((["sudo"] if sudo else []) + argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def du(path: Path, timeout: int = 120) -> int:
    r = run(["du", "-sb", "--one-file-system", str(path)], timeout)
    try:
        return int(r.stdout.split()[0]) if r and r.stdout else 0
    except (ValueError, IndexError):
        return 0


def note(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def storage_finding(sev: str, kind: str, path: Path, size: int, msg: str, regen: str, **kw) -> Finding:
    return Finding(sev, kind, short(path), f"{human(size)}: {msg}", "move it to the cleanup archive (undoable); purge later to free the space",
                   {"op": "trash", "path": str(path)}, module="storage", size=size, recover=regen, **kw)


# ------------------------------------------------------------ storage module

# (folder under ~/.cache, why it is safe, browser process to check)
KNOWN_CACHES = {
    "uv": ("uv download cache, refilled on the next uv sync", ""),
    "pip": ("pip cache", ""),
    "go-build": ("Go build cache", ""),
    "yarn": ("yarn cache", ""),
    "node-gyp": ("node-gyp headers", ""),
    "pre-commit": ("pre-commit environments, rebuilt on next run", ""),
    "ms-playwright": ("Playwright browsers; `npx playwright install` brings them back", ""),
    "puppeteer": ("Puppeteer browsers, downloaded again on demand", ""),
    "tracker3": ("GNOME file index, rebuilt in the background", ""),
    "thumbnails": ("image thumbnails", ""),
    "mesa_shader_cache": ("GPU shader cache", ""),
    "BraveSoftware": ("Brave browser cache", "brave"),
    "google-chrome": ("Chrome browser cache", "chrome"),
    "huggingface": ("downloaded models; re-download can be slow", ""),
}
TOOL_CACHES = [
    (Path("~/.npm/_cacache"), "npm cache"),
    (Path("~/.cargo/registry/cache"), "cargo downloaded crates"),
    (Path("~/.cargo/registry/src"), "cargo unpacked crate sources"),
    (Path("~/.gradle/caches"), "Gradle caches"),
    (Path("~/.bun/install/cache"), "bun install cache"),
    (Path("~/.pub-cache/hosted"), "Dart/Flutter pub packages"),
]
CACHE_MIN = 200 * 1024**2
ARTIFACT_MIN = 100 * 1024**2


def proc_running(name: str) -> bool:
    r = run(["pgrep", "-x", name], 5)
    return bool(r and r.returncode == 0)


def scan_storage(deep: bool, artifact_days: int) -> list[Finding]:
    out: list[Finding] = []
    note("storage: caches...")
    cache = HOME / ".cache"
    if cache.is_dir():
        for child in sorted(cache.iterdir()):
            if not child.is_dir() or child.is_symlink():
                continue
            size = du(child)
            if size < CACHE_MIN:
                continue
            why, proc = KNOWN_CACHES.get(child.name, ("", ""))
            if not why and time.time() - child.stat().st_mtime < 3 * 86400:
                out.append(Finding("low", "cache-recent", short(child), f"{human(size)}: unrecognised folder changed in the last 3 days, may be in use",
                                   "left alone; scan again later", module="storage", size=size))
                continue
            if proc and (proc_running(proc) or proc_running(proc + "-browser")):
                out.append(Finding("low", "cache-in-use", short(child), f"{human(size)}: {why}; the browser is running",
                                   "close it, then scan again", module="storage", size=size))
                continue
            if why:
                out.append(storage_finding("low", "cache", child, size, why, "regenerates"))
            else:
                out.append(storage_finding("low", "cache-unknown", child, size,
                    "folder not recognised (looks like a build or session scratch area); you decide, the archive lets you undo",
                    "quarantine"))
    for path, label in TOOL_CACHES:
        p = path.expanduser()
        if p.is_dir():
            size = du(p)
            if size >= 100 * 1024**2:
                out.append(storage_finding("low", "tool-cache", p, size, label, "regenerates"))
    trash = HOME / ".local/share/Trash"
    if trash.is_dir():
        size = du(trash)
        if size >= 50 * 1024**2:
            out.append(Finding("low", "desktop-trash", short(trash), f"{human(size)}: files you already deleted in the file manager",
                "empty it (permanent)", {"op": "rm", "path": str(trash), "keep_dir": True},
                module="storage", size=size, recover="irreversible"))

    note("storage: project build folders...")
    lab = HOME / "LAB"
    cutoff = time.time() - artifact_days * 86400
    if lab.is_dir():
        for root, dirs, _files in os.walk(lab):
            depth = len(Path(root).relative_to(lab).parts)
            keep = []
            for d in dirs:
                full = Path(root) / d
                if d in (".git", ".history", ".venv", "venv"):
                    continue
                marker = {"target": "Cargo.toml", "node_modules": "package.json"}.get(d)
                if marker and (Path(root) / marker).exists() and not full.is_symlink():
                    try:
                        if full.stat().st_mtime < cutoff:
                            size = du(full)
                            if size >= ARTIFACT_MIN:
                                age = (time.time() - full.stat().st_mtime) / 86400
                                out.append(storage_finding("low", "build-artifacts", full, size,
                                    f"{'Rust target' if d == 'target' else 'node_modules'} unused for {age:.0f} days; rebuilt by cargo/npm", "regenerates"))
                    except OSError:
                        pass
                    continue  # do not descend
                if depth < 6:
                    keep.append(d)
            dirs[:] = keep

    note("storage: /tmp...")
    tmp_cut = time.time() - 7 * 86400
    for child in Path("/tmp").iterdir() if Path("/tmp").is_dir() else []:
        try:
            st = child.lstat()
            if st.st_uid != os.getuid() or child.name.startswith(("claude-", ".X", "systemd-", "snap-", "tracker")) or st.st_mtime > tmp_cut:
                continue
            size = du(child) if child.is_dir() and not child.is_symlink() else st.st_size
            if size >= 50 * 1024**2:
                out.append(storage_finding("low", "tmp-old", child, size, "your file in /tmp, untouched for over 7 days", "quarantine"))
        except OSError:
            pass

    out += scan_system()
    out += scan_docker()
    if deep:
        note("storage: large files (deep)...")
        r = run(["find", str(HOME), "-xdev", "-type", "f", "-size", "+1G", "-not", "-path", f"{HOME}/.cache/*",
                 "-not", "-path", f"{HOME}/.local/share/Trash/*", "-printf", "%s\t%p\n"], 180)
        for line in sorted((r.stdout if r else "").splitlines(), key=lambda s: -int(s.split("\t")[0]))[:15]:
            size, p = line.split("\t", 1)
            out.append(Finding("info", "large-file", short(Path(p)), f"{human(int(size))}", "review by hand; nothing is offered automatically",
                               module="storage", size=int(size)))
    return out


def scan_system() -> list[Finding]:
    out: list[Finding] = []
    note("storage: system (apt, journal, snap)...")
    if shutil.which("apt-get") and Path("/var/cache/apt/archives").is_dir():
        size = du(Path("/var/cache/apt"))
        if size >= 100 * 1024**2:
            out.append(Finding("low", "apt-cache", "/var/cache/apt", f"{human(size)}: downloaded .deb files",
                "sudo apt-get clean", {"op": "cmd", "argv": ["apt-get", "clean"], "sudo": True},
                module="storage", size=size, recover="regenerates", risk="sudo"))
    r = run(["journalctl", "--disk-usage"], 15)
    m = re.search(r"take up ([\d.]+)([KMGT])", r.stdout) if r else None
    if m:
        size = int(float(m.group(1)) * 1024 ** ("KMGT".index(m.group(2)) + 1))
        if size >= 1024**3:
            out.append(Finding("low", "journal", "systemd journal", f"{human(size)} of logs",
                "keep the newest 500 MiB: sudo journalctl --vacuum-size=500M",
                {"op": "cmd", "argv": ["journalctl", "--vacuum-size=500M"], "sudo": True},
                module="storage", size=max(0, size - 500 * 1024**2), recover="irreversible", risk="sudo"))
    if shutil.which("snap"):
        r = run(["snap", "list", "--all"], 20)
        old = [ln.split() for ln in (r.stdout if r else "").splitlines() if "disabled" in ln]
        if old:
            out.append(Finding("low", "snap-old", "snap", f"{len(old)} disabled old snap revisions (the previous versions kept after updates)",
                "remove them one by one with: sudo snap remove NAME --revision=N (snap saves the user data first; `snap restore` can bring it back)",
                {"op": "cmd", "argv": ["sh", "-c", "snap list --all | awk '/disabled/{print $1, $3}' | while read n r; do snap remove \"$n\" --revision=\"$r\"; done"],
                 "sudo": True}, module="storage", recover="reinstall", risk="sudo"))
    if shutil.which("flatpak"):
        r = run(["flatpak", "uninstall", "--unused", "--assumeno"], 30)
        if r and "Uninstall complete" not in (r.stdout or "") and re.search(r"^\s*\d+\.", r.stdout or "", re.M):
            out.append(Finding("low", "flatpak-unused", "flatpak", "unused flatpak runtimes", "flatpak uninstall --unused",
                {"op": "cmd", "argv": ["flatpak", "uninstall", "--unused", "-y"], "sudo": False},
                module="storage", recover="reinstall"))
    return out


