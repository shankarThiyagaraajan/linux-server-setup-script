def cat_of(f: Finding) -> str:
    return KIND_CATEGORY.get(f.kind, "mem-tidy" if f.module == "claude" else "notes")


def has_secrets(path: Path, cap: int = 4000) -> bool:
    """Cheap look for secret-looking file names inside a folder we are about to archive."""
    n = 0
    try:
        if path.is_file():
            return bool(SECRET_NAMES.search(path.name))
        for _root, _dirs, files in os.walk(path):
            for name in files:
                n += 1
                if SECRET_NAMES.search(name):
                    return True
            if n > cap:
                break
    except OSError:
        pass
    return False


def mark_sensitive(findings: list[Finding]) -> None:
    for f in findings:
        if f.kind in ("cache-unknown", "tmp-old") and f.fix.get("path"):
            f.sensitive = has_secrets(Path(f.fix["path"]))


def bar(parts: list[tuple[float, str]], width: int, on: bool) -> str:
    """Segmented bar: parts are (fraction of the whole, colour); the rest is empty."""
    out, used = "", 0
    for frac, code in parts:
        n = min(width - used, round(max(0.0, frac) * width))
        if frac > 0 and n == 0 and used < width:
            n = 1  # keep tiny shares visible
        out += paint("█" * n, code, on)
        used += n
    return out + paint("░" * (width - used), "\033[2m", on)


def paint(text: str, code: str, on: bool) -> str:
    return f"{code}{text}{RESET}" if on else text


def category_rows(findings: list[Finding]) -> list[dict]:
    rows: dict[str, dict] = {}
    for f in findings:
        k = cat_of(f)
        r = rows.setdefault(k, {"key": k, "items": [], "size": 0, "fixable": 0, "sensitive": False})
        r["items"].append(f)
        r["size"] += f.size if f.fix else 0
        r["fixable"] += 1 if f.fix else 0
        r["sensitive"] |= f.sensitive
    order = {"safe": 0, "review": 1, "caution": 2, "info": 3}
    mod_order = {m: i for i, m in enumerate(MODULES)}
    def sort_key(r):
        mod = r["items"][0].module
        return (mod_order[mod], order[CATEGORIES[r["key"]][1]], -r["size"])
    out = sorted(rows.values(), key=sort_key)
    visible = [r for r in out if r["key"] != "notes"]
    for r in out:
        r["hot"] = ""
        r["module"] = r["items"][0].module
    for i, r in enumerate(visible):
        r["hot"] = HOTKEYS[i] if i < len(HOTKEYS) else ""
    return out


# ------------------------------------------------------------ tables and report
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def cw(ch: str) -> int:
    if unicodedata.combining(ch) or ch in "️‍":
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def vlen(s: str) -> int:
    return sum(cw(c) for c in ANSI_RE.sub("", s))


def clip(text: str, w: int, left: bool = False) -> str:
    if vlen(text) <= w:
        return text
    out = ""
    for ch in (reversed(text) if left else text):
        if vlen(out) + cw(ch) > w - 1:
            break
        out = ch + out if left else out + ch
    return ("…" + out) if left else (out + "…")


def term_width() -> int:
    return max(70, shutil.get_terminal_size((110, 20)).columns - 2)


def table(headers: list[str], rows: list[list], aligns: str, color: bool, flex: list[int] | None = None,
          clip_left: set[int] | None = None, title: str = "", head_code: str = "\033[1m", indent: str = "  ") -> None:
    """Rounded box table. A cell is text or (text, ansi-code). Columns in `flex` shrink to fit the terminal."""
    flex, clip_left = flex or [], clip_left or set()
    norm = [[c if isinstance(c, tuple) else (str(c), "") for c in row] for row in rows]
    n = len(headers)
    widths = [max([vlen(headers[i])] + [vlen(r[i][0]) for r in norm]) for i in range(n)]
    over = sum(widths) + 3 * n + 1 + len(indent) - term_width()
    for i in flex:
        if over <= 0:
            break
        cut = min(over, max(0, widths[i] - 14))
        widths[i] -= cut
        over -= cut

    def cell(text: str, code: str, i: int, align: str) -> str:
        text = clip(text, widths[i], i in clip_left) if not ANSI_RE.search(text) else text
        pad = " " * (widths[i] - vlen(text))
        body = paint(text, code, color) if code else text
        return (pad + body) if align == "r" else (body + pad) if align == "l" else (" " * (pad.__len__() // 2) + body + " " * (pad.__len__() - pad.__len__() // 2))

    def rule(l: str, m: str, r: str) -> str:
        return indent + l + m.join("─" * (w + 2) for w in widths) + r

    if title:
        print(f"{indent}{title}")
    print(paint(rule("╭", "┬", "╮"), "\033[2m", color))
    bar_ = paint("│", "\033[2m", color)
    print(indent + bar_ + bar_.join(" " + cell(h, head_code, i, "c" if aligns[i] == "c" else aligns[i]) + " " for i, h in enumerate(headers)) + bar_)
    print(paint(rule("├", "┼", "┤"), "\033[2m", color))
    for row in norm:
        print(indent + bar_ + bar_.join(" " + cell(t, c, i, aligns[i]) + " " for i, (t, c) in enumerate(row)) + bar_)
    print(paint(rule("╰", "┴", "╯"), "\033[2m", color))


def show(findings: list[Finding], stats: dict, rows: list[dict] | None = None) -> list[dict]:
    """High-level report as tables: resources, savings, then one table per module."""
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    rows = rows if rows is not None else category_rows(findings)
    du_ = shutil.disk_usage("/")
    mi = meminfo()
    by_safety = {"safe": 0, "review": 0, "caution": 0}
    for r in rows:
        if r["module"] == "storage":
            by_safety[CATEGORIES[r["key"]][1]] = by_safety.get(CATEGORIES[r["key"]][1], 0) + r["size"]
    total = sum(by_safety.values())
    G, Y, R, D = SAFETY_COLOR["safe"], SAFETY_COLOR["review"], SAFETY_COLOR["caution"], SAFETY_COLOR["info"]
    BOLD = "\033[1m"

    def level(p: float) -> str:
        return G if p < 0.70 else Y if p < 0.88 else R

    def res(label: str, p: float, used: str, free: str, tot: str) -> list:
        return [(label, BOLD), bar([(p, level(p))], 24, color), (f"{p:.0%}", level(p)), used, free, tot]

    print()
    rrows = [res("💾 Disk", du_.used / du_.total, human(du_.used), human(du_.free), human(du_.total))]
    freeable = by_safety["safe"] + by_safety["review"]
    if freeable:
        p2 = max(0, du_.used - freeable) / du_.total
        rrows.append(res("✨ After cleanup", p2, human(max(0, du_.used - freeable)), human(du_.free + freeable), human(du_.total)))
    ru = mi["MemTotal"] - mi["MemAvailable"]
    rrows.append(res("🧠 RAM", ru / mi["MemTotal"], human(ru), human(mi["MemAvailable"]) + " available", human(mi["MemTotal"])))
    st, sf = mi.get("SwapTotal", 0), mi.get("SwapFree", 0)
    if st:
        rrows.append(res("🔁 Swap", (st - sf) / st, human(st - sf), human(sf), human(st)))
    table(["Resource", "Usage", "%", "Used", "Free", "Total"], rrows, "lllrrr", color, title=paint("📊 RESOURCES", BOLD, color))

    if total:
        print()
        meaning = {"safe": "grows back by itself", "review": "your call; undo with `cleanup --recover`", "caution": "cannot be undone"}
        srows = []
        for k, label in (("safe", "🟢 Safe"), ("review", "🟡 Review"), ("caution", "🔴 Cannot undo")):
            srows.append([(label, SAFETY_COLOR[k]), (human(by_safety[k]), SAFETY_COLOR[k]),
                          bar([(by_safety[k] / total, SAFETY_COLOR[k])], 20, color), meaning[k]])
        srows.append([("💰 Total", BOLD), (human(total), BOLD), bar([(by_safety["safe"] / total, G), (by_safety["review"] / total, Y), (by_safety["caution"] / total, R)], 20, color),
                      "cleaning archives first; `cleanup --purge` releases the space"])
        table(["Savings", "Reclaimable", "Share", "What it means"], srows, "lrll", color, flex=[3], title=paint("💰 WHAT YOU CAN SAVE", BOLD, color))

    notes = []
    skipped = [f for f in findings if f.kind in ("cache-recent", "cache-in-use")]
    if skipped:
        notes.append(["⏳ Left alone", f"{len(skipped)} folders, {human(sum(f.size for f in skipped))} are in use or changed in the last 3 days (see -c notes)"])
    held = sum(e.get("bytes", 0) for b in list_batches() for e in load_manifest(b))
    if held:
        notes.append([("📥 Archived", Y), (f"{human(held)} archived, not yet freed: [p] or `cleanup --purge` (undo: `cleanup --recover`)", Y)])
    if stats.get("folders"):
        notes.append(["📝 Claude memory", f"{stats['memories']} notes in {stats['folders']} folders"])
    if notes:
        print()
        table(["Note", "Detail"], notes, "ll", color, flex=[1], title=paint("ℹ NOTES", BOLD, color))

    biggest = max([r["size"] for r in rows if r["module"] != "claude"] + [1])
    for mod in MODULES:
        mrows = [r for r in rows if r["module"] == mod and not ((r["key"] == "notes" or (r["key"] == "mem-tidy" and not r["fixable"])) and not r.get("cleaned"))]
        if not mrows:
            continue
        out = []
        for r in mrows:
            title, safety, blurb = CATEGORIES[r["key"]]
            sc = SAFETY_COLOR[safety]
            hot = r["hot"] or ""
            if r.get("cleaned") and not r["items"]:
                out.append([(hot, BOLD), (title, G), ("0", G), ("0 B", G), bar([(0, G)], 10, color), ("✅ Done", G),
                            (f"{human(r['cleaned'])} cleaned" if r["cleaned"] > 1 else "cleaned", G)])
                continue
            size = human(r["size"]) if r["size"] else "-"
            mini = bar([(r["size"] / biggest, sc)], 10, color) if r["size"] and mod != "claude" else " " * 10
            note = blurb + ("  🔑 may hold secrets" if r["sensitive"] else "") + (f"  (+{human(r['cleaned'])} cleaned)" if r.get("cleaned") else "")
            out.append([(hot, BOLD), (title, sc), str(len(r["items"])), (size, sc if r["size"] else D), mini, (SAFETY_LABEL[safety], sc),
                        (note, "\033[1;31m" if r["sensitive"] else "")])
        print()
        table(["Key", "Category", "Items", "Size", "Share", "Safety", "Note"], out, "lllrlll" if False else "llrrlll", color, flex=[6, 1],
              title=f"{MODULE_ICON[mod]} {paint(MODULE_TITLE[mod], MODULE_COLOR[mod], color)}")
    return rows


def show_details(rows: list[dict], keys: list[str] | None, limit: int | None = 15) -> None:
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    for r in rows:
        if keys and r["key"] not in keys:
            continue
        title, safety, blurb = CATEGORIES[r["key"]]
        sc = SAFETY_COLOR[safety]
        items = sorted(r["items"], key=lambda f: (-f.size, f.where))
        shown = items if limit is None else items[:limit]
        out = []
        for f in shown:
            flags = [x for x in (SHORT_RECOVER.get(recover_kind(f), ""), "needs sudo" if f.risk == "sudo" else "", "🔑 may hold secrets" if f.sensitive else "") if x]
            out.append([(human(f.size) if f.size else "-", sc), f.where, f.message.split(": ", 1)[-1] if f.size else f.message, "; ".join(flags)])
        print()
        table(["Size", "Item", "What it is", "Undo / flags"], out, "rlll", color, flex=[2, 1], clip_left={1},
              title=f"{paint(title, chr(27) + '[1m', color)}  {paint(SAFETY_LABEL[safety], sc, color)}  ({blurb})")
        if limit is not None and len(items) > limit:
            print(f"  ... and {len(items) - limit} more (cleanup --scan -c {r['key']} --all)")


def plan_tag(f: Finding) -> str:
    rk = recover_kind(f)
    tags = []
    if f.risk == "terminate":
        tags.append("⚠ quits the running app")
    if f.risk == "sudo":
        tags.append("needs sudo")
    if rk == "irreversible":
        tags.append("⚠ CANNOT be undone")
    return ", ".join(tags) or (RECOVER_TEXT.get(rk, rk) or "reversible")


def clean(findings: list[Finding], assume_yes: bool, dry: bool) -> list[Finding]:
    """List every touch point first, then one choice: yes to all, one by one, or cancel."""
    items = []
    for f in findings:
        if not f.fix:
            continue
        target = f.fix.get("path") or f.fix.get("index") or f.fix.get("dst") or f.fix.get("dir")
        if target and not Path(target).exists():
            continue
        items.append(f)
    if not items:
        print("Nothing fixable automatically.")
        return []
    if not sys.stdin.isatty() and not (assume_yes or dry):
        print("--clean needs a terminal to ask questions (or pass -y / --dry-run).", file=sys.stderr)
        return []
    # index lines bottom-up; harmless items first, sudo next, app-quitting items always last
    items.sort(key=lambda f: ({"terminate": 2, "sudo": 1}.get(f.risk, 0), -f.fix.get("line", 0), -f.size))
    print(f"\nPlanned changes ({len(items)}):")
    for i, f in enumerate(items, 1):
        sz = f"  {human(f.size)}" if f.size else ""
        print(f"  {i:>3}. [{MODULE_TITLE[f.module]}] {f.kind}: {f.where}{sz}  ({plan_tag(f)})")
    batch = Batch(time.strftime("%Y%m%d-%H%M%S"))
    if dry:
        for f in items:
            print(f"\n[{MODULE_TITLE[f.module]}] {f.kind}: {f.where}\n  {apply_fix(f, batch, dry=True)}")
        return []
    n_irr = sum(1 for f in items if recover_kind(f) == "irreversible")
    n_term = sum(1 for f in items if f.risk == "terminate")
    mode = "y" if assume_yes else key("\n  [y] yes to all / [o] one by one / [N] cancel: ", "n")
    if mode not in ("y", "o"):
        print("  cancelled, nothing changed.")
        return []
    allow_irr = False
    if mode == "y" and n_irr and not assume_yes:
        allow_irr = input(f"  {n_irr} of these CANNOT be undone (marked ⚠). Type 'yes' to include them, anything else skips them: ").strip() == "yes"
    done, freed_now = 0, 0
    applied: list[Finding] = []
    for f in items:
        rk = recover_kind(f)
        permanent = False
        if mode == "y":
            if rk == "irreversible" and not allow_irr:
                print(f"\n[{MODULE_TITLE[f.module]}] {f.kind}: {f.where}\n  skipped (cannot be undone)")
                continue
            if f.risk == "terminate" and assume_yes:
                print(f"\n[{MODULE_TITLE[f.module]}] {f.kind}: {f.where}\n  skipped (quits a running app; run without -y)")
                continue
            print(f"\n[{MODULE_TITLE[f.module]}] {f.kind}: {f.where}")
        else:
            print(f"\n[{MODULE_TITLE[f.module]}] {f.kind}: {f.where}\n  {f.message}\n  -> {f.action}  ({plan_tag(f)})")
            if rk == "irreversible":
                if input("  this CANNOT be undone. Type 'yes' to continue: ").strip() != "yes":
                    continue
            else:
                perm_ok = f.fix["op"] == "trash" and f.module == "storage"
                ans = key("  apply? [y]es / [N]o / [q]uit" + (" / [p]ermanent delete now" if perm_ok else "") + ": ", "n")
                if ans == "q":
                    break
                if ans == "p" and perm_ok:
                    if input("  permanent: no recovery. Type 'yes': ").strip() != "yes":
                        continue
                    permanent = True
                elif ans != "y":
                    continue
        try:
            print("  " + apply_fix(f, batch, permanent=permanent))
            done += 1
            applied.append(f)
            if permanent:
                freed_now += f.size
        except Exception as e:  # keep going; one failure must not lose the manifest
            print(f"  failed: {e}")
        batch.save()
        batch.entries = []
    print(f"\n{done} change(s) applied." + (f" Freed at once: {human(freed_now)}." if freed_now else ""))
    if done and (batch.dir / "manifest.json").exists():
        print(f"Archive: {short(batch.dir)}\n  undo:  cleanup --recover {batch.stamp}\n  free the held space later: cleanup --purge")
    return applied


def apply_done(rows: list[dict], findings: list[Finding], applied: list[Finding]) -> list[Finding]:
    """Remove cleaned findings in place, keeping the rows (and their hotkeys) so the report stays put."""
    gone = {id(f) for f in applied}
    for r in rows:
        r["cleaned"] = r.get("cleaned", 0) + sum(max(f.size, 1) for f in r["items"] if id(f) in gone)
        r["items"] = [f for f in r["items"] if id(f) not in gone]
        r["size"] = sum(f.size for f in r["items"] if f.fix)
        r["fixable"] = sum(1 for f in r["items"] if f.fix)
        r["sensitive"] = any(f.sensitive for f in r["items"])
    return [f for f in findings if id(f) not in gone]


def explore(args) -> None:
    """Scan, show the summary, then drill into a category or clean; the report stays and updates."""
    findings, stats = collect(args)
    rows = category_rows(findings)
    show(findings, stats, rows)
    if not findings:
        print("\n  Nothing to clean up.")
        return
    while True:
        c = key("\n  Number/letter = details, [c] clean all fixable, [a] all details, [p] purge archive, [r] redraw, [q] back: ", "q")
        if c in ("q", ""):
            return
        if c == "a":
            show_details(rows, None, None)
        elif c == "r":
            show(findings, stats, rows)
        elif c == "p":
            purge(None, False)
            show(findings, stats, rows)
        elif c == "c":
            # "clean all" never quits running apps; those are only offered from their own category (the apps list)
            bulk = [f for f in findings if f.fix and f.risk != "terminate"]
            n_skip = sum(1 for f in findings if f.fix and f.risk == "terminate")
            if n_skip:
                print(f"\n  Running apps are not part of 'clean all' ({n_skip} left out); quit them from the apps category.")
            applied = clean(bulk, False, False)
            findings = apply_done(rows, findings, applied)
            show(findings, stats, rows)
        else:
            r = next((r for r in rows if r["hot"] == c and r["key"] != "notes"), None)
            if not r:
                continue
            show_details(rows, [r["key"]], None)
            if r["fixable"]:
                applied = clean([f for f in findings if cat_of(f) == r["key"]], False, False)
                findings = apply_done(rows, findings, applied)
                show(findings, stats, rows)


def menu(args) -> int:
    while True:
        n = len(list_batches())
        print("\ncleanup: storage, RAM and Claude memory\n"
              "  1) Scan everything          overview of space, RAM and notes (changes nothing)\n"
              "  2) Storage                  caches, build folders, Docker, system\n"
              "  3) RAM                      pressure, swap, biggest apps\n"
              "  4) Claude memory            index, stale and duplicate notes\n"
              f"  5) Recover                  put back archived items ({n} batch{'es' if n != 1 else ''})\n"
              "  6) Purge                    permanently free archived items\n"
              "  7) Deep storage scan        also finds files over 1 GiB\n"
              "  q) Quit                     (cleanup --help lists every option)")
        c = key("Choose: ", "q")
        pick = {"1": None, "2": ["storage"], "3": ["ram"], "4": ["claude"], "7": ["storage"]}
        if c in pick:
            args.module = pick[c]
            args.deep = c == "7"
            explore(args)
        elif c == "5":
            recover(None, False)
        elif c == "6":
            purge(None, False)
        elif c in ("q", ""):
            return 0


def main() -> int:
    args = build_parser().parse_args()
    if args.list_trash:
        bs = list_batches()
        print("Archive is empty." if not bs else "")
        for b in bs:
            print(batch_summary(b))
            for e in load_manifest(b):
                print("   ", entry_line(e))
        return 0
    if args.recover is not None:
        return recover(args.recover or None, args.yes)
    if args.purge is not None:
        return purge(None if args.purge < 0 else args.purge, args.yes)
    if args.json:
        findings, _ = collect(args)
        print(json.dumps([dict(asdict(f), category=cat_of(f)) for f in findings], indent=2))
        return 0
    if not (args.scan or args.clean) and sys.stdin.isatty() and sys.stdout.isatty():
        return menu(args)
    findings, stats = collect(args)
    if args.category:
        findings = [f for f in findings if cat_of(f) in args.category]
        show_details(category_rows(findings), args.category, None if args.all else 15)
    else:
        rows = show(findings, stats)
        if args.all:
            show_details(rows, None, None)
        elif findings and not args.clean:
            print("\n  Details: cleanup --scan -c <category>   (names: " + ", ".join(r["key"] for r in rows if r["key"] != "notes") + ")")
    if args.clean:
        clean(findings, args.yes, args.dry_run)
    elif findings:
        print("  Next: cleanup --clean [-c category]   cleanup --recover   cleanup --purge   cleanup --help")
    return 0


def run_main() -> int:
    try:
        return main()
    except (KeyboardInterrupt, EOFError):
        print("\n\n  👋 Good bye! Nothing is left half-done: anything already cleaned is archived "
              "(undo with `cleanup --recover`).\n")
        return 130
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(run_main())
